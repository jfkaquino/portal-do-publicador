@inject IRepository Repository
@implements IDialogContentComponent<NovoUsuarioDto>

@using Mapster
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using PortalDoPublicador.Client.Infrastructure.Validation
@using PortalDoPublicador.Shared.Features.Perfis
@using PortalDoPublicador.Shared.Infrastructure.Data

<style>
    .w-100 {
        width: 100%;
        min-width: 0;
    }
</style>

<FluentDialogHeader ShowDismiss="true">
    <FluentLabel Typo="Typography.PaneHeader">Novo Usuário</FluentLabel>
</FluentDialogHeader>

<FluentDialogBody>
    <EditForm id="form-novo-usuario" Model="@Content" OnValidSubmit="@SaveAsync">
        <FluentValidationValidator />

        <FluentGrid Spacing="2">

            <!-- SEÇÃO: DADOS PESSOAIS -->
            <FluentGridItem xs="12">
                <FluentLabel Typo="Typography.H6">Dados Pessoais</FluentLabel>
            </FluentGridItem>

            <FluentGridItem xs="12" sm="8">
                <FluentTextField @bind-Value="Content.NomeCompleto"
                                 @bind-Value:after="AtualizarNomeExibicao"
                                 Label="Nome Completo" Required class="w-100" />
                <FluentValidationMessage For="@(() => Content.NomeCompleto)" />
            </FluentGridItem>

            <FluentGridItem xs="6" sm="4">
                <FluentSelect TOption="Familia" Items="@Familias"
                              OptionText="@(f => f.Nome)" OptionValue="@(f => f.Id.ToString())"
                              @bind-SelectedOption="Content.Familia"
                              Label="Família" class="w-100" />
            </FluentGridItem>

            <FluentGridItem xs="6" sm="6">
                <FluentTextField @bind-Value="Content.NomeExibicao"
                                 @bind-Value:after="() => _nomeExibicaoEditadoManualmente = true"
                                 Label="Nome de Exibição" Required class="w-100" />
                <FluentValidationMessage For="@(() => Content.NomeExibicao)" />
            </FluentGridItem>

            <FluentGridItem xs="6" sm="3">
                <FluentDatePicker @bind-Value="Content.DataNascimento"
                                  Label="Data de Nascimento" Required class="w-100" />
                <FluentValidationMessage For="@(() => Content.DataNascimento)" />
            </FluentGridItem>

            <FluentGridItem xs="6" sm="3">
                <FluentRadioGroup @bind-Value="Content.IsMasculino" Label="Sexo" Required class="w-100">
                    <FluentRadio Value="true">Masculino</FluentRadio>
                    <FluentRadio Value="false">Feminino</FluentRadio>
                </FluentRadioGroup>
                <FluentValidationMessage For="@(() => Content.IsMasculino)" />
            </FluentGridItem>

            <FluentGridItem xs="12">
                <FluentLabel Typo="Typography.H6">Contato</FluentLabel>
            </FluentGridItem>

            <FluentGridItem xs="12" sm="6">
                <FluentTextField @bind-Value="Content.Email" Label="E-mail" Required class="w-100" />
                <FluentValidationMessage For="@(() => Content.Email)" />
            </FluentGridItem>

            <FluentGridItem xs="12" sm="6">
                <FluentTextField @bind-Value="Content.Telefone" Label="Telefone" Required class="w-100" />
                <FluentValidationMessage For="@(() => Content.Telefone)" />
            </FluentGridItem>

            <FluentGridItem xs="12">
                <FluentTextField @bind-Value="Content.Endereco" Label="Endereço" Required class="w-100" />
                <FluentValidationMessage For="@(() => Content.Endereco)" />
            </FluentGridItem>

            <!-- SEÇÃO: PERFIL ESPIRITUAL -->
            <FluentGridItem xs="12">
                <FluentLabel Typo="Typography.H6">Perfil espiritual</FluentLabel>
            </FluentGridItem>

            <FluentGridItem xs="6" sm="6">
                <FluentSelect TOption="SituacaoEspiritual" Items="@(Enum.GetValues<SituacaoEspiritual>())"
                              OptionText="@(e => e.GetDisplayName())" OptionValue="@(e => ((int)e).ToString())"
                              @bind-SelectedOption="Content.SituacaoEspiritual"
                              Label="Situação Espiritual" class="w-100" />
                <FluentValidationMessage For="@(() => Content.SituacaoEspiritual)" />
            </FluentGridItem>

            <FluentGridItem xs="6" sm="6">
                <FluentSelect TOption="ModalidadePioneiro" Items="@(Enum.GetValues<ModalidadePioneiro>())"
                              OptionText="@(e => e.GetDisplayName())" OptionValue="@(e => ((int)e).ToString())"
                              @bind-SelectedOption="Content.ModalidadePioneiro"
                              Label="Modalidade de Pioneiro" class="w-100" />
                <FluentValidationMessage For="@(() => Content.ModalidadePioneiro)" />
            </FluentGridItem>

        </FluentGrid>
    </EditForm>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@CancelAsync">Cancelar</FluentButton>
    <FluentButton Type="ButtonType.Submit" form="form-novo-usuario" Appearance="Appearance.Accent">Criar Usuário</FluentButton>
</FluentDialogFooter>

@code {
    [Parameter] public NovoUsuarioDto Content { get; set; } = default!;
    [CascadingParameter] public FluentDialog Dialog { get; set; } = default!;

    private bool _nomeExibicaoEditadoManualmente = false;
    public List<Familia> Familias { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Content ??= new NovoUsuarioDto();
        Familias = await Repository.ObterTodosAsync<Familia>();
    }

    private void AtualizarNomeExibicao()
    {
        if (!_nomeExibicaoEditadoManualmente && !string.IsNullOrWhiteSpace(Content.NomeCompleto))
        {
            var partes = Content.NomeCompleto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (partes.Length > 0)
            {
                Content.NomeExibicao = partes[0];
            }
        }
    }

    private async Task SaveAsync() => await Dialog.CloseAsync(Content);
    private async Task CancelAsync() => await Dialog.CancelAsync();
}