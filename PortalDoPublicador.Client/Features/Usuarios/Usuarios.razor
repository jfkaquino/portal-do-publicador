@page "/usuarios"
@using PortalDoPublicador.Shared.Features.Perfis
@using Microsoft.FluentUI.AspNetCore.Components
@using Mapster
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using Microsoft.EntityFrameworkCore
@using PortalDoPublicador.Client.Components.Grid
@inject IDialogService DialogService
@inject IToastService ToastService
@using PortalDoPublicador.Shared.Infrastructure.Data
@inject IRepository Repository

<FluentStack Orientation="Orientation.Vertical" Width="100%" Style="gap: 16px;">
    <FluentLabel Typo="Typography.PageTitle">Usuários</FluentLabel>
    
    <Grid TItem="Usuario"
            Items="@usuarios"
            OnItemClick="@AbrirModalUsuarioAsync"
            GridTemplateColumns="2fr 1fr 1fr 1.5fr">
        <Definicoes>

            <GridAcao Texto="teste"
                        Icone="@(new Icons.Regular.Size16.Accessibility())"
                        Aparencia="@Appearance.Neutral" />

            <GridAcao Texto="Novo"
                        Icone="@(new Icons.Regular.Size16.Add())"
                        Aparencia="@Appearance.Accent"
                        OnClick="@(() => AbrirModalUsuarioAsync(null))" />

            <!-- O uso de Context="usuario" evita conflitos com a palavra 'context' padrão do Blazor -->
            <GridColuna TItem="Usuario"
                          Titulo="Nome exibição"
                          SortBy="@(GridSort<Usuario>.ByAscending(u => u.NomeExibicao))"
                          Context="usuario">
                <FluentStack>
                    <FluentPersona Initials="@ObterIniciaisPersona(usuario.NomeExibicao)" ImageSize="32px" />
                    <FluentLabel>@usuario.NomeExibicao</FluentLabel>
                </FluentStack>
            </GridColuna>

            <GridColuna TItem="Usuario"
                          Titulo="Nascimento"
                          Valor="@(u => u.DataNascimento.ToString("dd/MM/yyyy"))"
                          SortBy="@(GridSort<Usuario>.ByAscending(u => u.DataNascimento))" />

            <GridColuna TItem="Usuario"
                          Titulo="Telefone"
                          Valor="@(u => u.Telefone)"
                          SortBy="@(GridSort<Usuario>.ByAscending(u => u.Telefone))" />

            <GridColuna TItem="Usuario"
                          Titulo="E-mail"
                          Valor="@(u => u.Email)"
                          SortBy="@(GridSort<Usuario>.ByAscending(u => u.Email))" />
        </Definicoes>
    </Grid>
</FluentStack>

@code {
    private List<Usuario>? usuarios = null;
    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuariosAsync();
    }

    private async Task CarregarUsuariosAsync()
    {
        usuarios = await Repository.Query<Usuario>()
            .Include(u => u.Perfil)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task AbrirModalUsuarioAsync(Usuario? usuario = null)
    {
        bool isNovo = usuario == null;
        NovoUsuarioDto formModel;

        if (isNovo)
        {
            formModel = new NovoUsuarioDto();
        }
        else
        {
            formModel = usuario!.Adapt<NovoUsuarioDto>();
            formModel.FamiliaId = usuario.Familia?.Id;
            formModel.Id = usuario.Id;
        }

        var dialog = await DialogService.ShowDialogAsync<CriarUsuarioDialog>(formModel, new DialogParameters
        {
            Title = string.Empty,
            ShowTitle = false,
            Width = "600px",
            ShowDismiss = false,
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = true
        });

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data is NovoUsuarioDto formResult)
        {
            if (isNovo)
            {
                usuario = formResult.Adapt<Usuario>();
            }
            else
            {
                formResult.Adapt(usuario);
            }

            if (formResult.FamiliaId.HasValue)
            {
                usuario.Familia = await Repository.ObterPorIdAsync<Familia>(formResult.FamiliaId.Value);
            }
            else
            {
                usuario.Familia = null;
            }

            if (isNovo)
            {
                if (usuario.Id == Guid.Empty)
                    usuario.Id = Guid.NewGuid();

                if (usuario.Perfil is not null && usuario.Perfil.Id == Guid.Empty)
                {
                    usuario.Perfil.Id = Guid.NewGuid();
                    usuario.Perfil.Usuario = usuario;
                }
            }

            if (isNovo)
            {
                await Repository.InserirAsync(usuario);
                ToastService.ShowSuccess("Usuário criado com sucesso!");
            }
            else
            {
                await Repository.AtualizarAsync(usuario);
                ToastService.ShowSuccess("Usuário editado com sucesso!");
            }

            await CarregarUsuariosAsync();
        }
    }

    public static string ObterIniciaisPersona(string nomeExibicao)
    {
        if (string.IsNullOrWhiteSpace(nomeExibicao))
            return string.Empty;

        // Limpa espaços extras no começo e no fim, e divide pelas partes do nome
        var partes = nomeExibicao.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 1)
        {
            // Se tem só um nome (ex: "Jorge"), pega as duas primeiras letras
            var nomeUnico = partes[0];
            return nomeUnico.Length > 1
                ? nomeUnico.Substring(0, 2).ToUpperInvariant()
                : nomeUnico.ToUpperInvariant(); // Caso o nome tenha só 1 letra
        }

        // Se tem mais de um nome (ex: "Jorge Fernando Aquino"), pega a primeira letra do primeiro e do último
        var primeiraLetraPrimeiroNome = partes[0][0];
        var primeiraLetraUltimoNome = partes[^1][0]; // Operador de índice de fim (^1) do C# 8+

        return $"{primeiraLetraPrimeiroNome}{primeiraLetraUltimoNome}".ToUpperInvariant();
    }
}

