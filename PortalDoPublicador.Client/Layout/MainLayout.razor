@inherits LayoutComponentBase

<div class="layout-wrapper" style="height: 100vh; overflow: hidden;">
    <FluentLayout>
        <FluentHeader>
            <FluentButton BackgroundColor="rgba(0, 0, 0, 0)"
                          @onclick="(() => menuExpanded = !menuExpanded)" Style="margin-right: 5px;">
                <FluentIcon Value="@(new Icons.Regular.Size20.LineHorizontal3())" Color="Color.Fill" />
            </FluentButton>

            <FluentLabel Typo="Typography.H5" Color="Color.Fill" @onclick='() => NavManager.NavigateTo("/")' title="Ir ao início" style="cursor: pointer;">
                Portal do Publicador
            </FluentLabel>

            <FluentSpacer />

            <FluentButton BackgroundColor="rgba(0, 0, 0, 0)">
                <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" Color="Color.Fill" />
            </FluentButton>
        </FluentHeader>

        <FluentStack Orientation="Orientation.Horizontal" Style="height: calc(100vh - 50px);">

            <FluentNavMenu Width="280"
                           Class="@($"responsive-nav {(menuExpanded ? "is-expanded" : "is-collapsed")}")"
                           Collapsible="false"
                           CollapsedChildNavigation="true"
                           @bind-Expanded="menuExpanded"
                           Style="height: 100%; background-color: var(--neutral-layer-1); border-right: 1px solid var(--neutral-stroke-divider-rest);">

                <FluentNavLink Href="programacoes" Icon="@(new Icons.Regular.Size20.Calendar())">Programações</FluentNavLink>
                <FluentNavLink Href="" Icon="@(new Icons.Regular.Size20.PersonAvailable())">Designações</FluentNavLink>
                <FluentNavLink Href="" Icon="@(new Icons.Regular.Size20.Map())">Territórios</FluentNavLink>
                <FluentNavLink Href="" Icon="@(new Icons.Regular.Size20.Clock())">Relatório</FluentNavLink>

                <FluentNavGroup Title="Congregação" Icon="@(new Icons.Regular.Size20.BuildingPeople())">
                    <FluentNavLink Href="usuarios" Title="Usuários" Icon="@(new Icons.Regular.Size20.People())">Usuários</FluentNavLink>
                </FluentNavGroup>
            </FluentNavMenu>

            <FluentBodyContent Style="padding: 24px; overflow-y: auto;">
                @Body
            </FluentBodyContent>

        </FluentStack>

        <FluentToastProvider />
        <FluentMessageBarProvider />
        <FluentDialogProvider />
        <FluentMenuProvider />
    </FluentLayout>
</div>

@code {
    // Declaração do NavigationManager (caso não esteja declarado no seu _Imports.razor)
    [Inject] public NavigationManager NavManager { get; set; } = default!;

    // 3. Variável que guarda o estado do menu
    private bool menuExpanded = true;
}