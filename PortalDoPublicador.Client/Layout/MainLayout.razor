@inherits LayoutComponentBase

<FluentLayout>
    <FluentHeader>
        <FluentButton BackgroundColor="rgba(0, 0, 0, 0)"
                      OnClick="@(() => menuExpanded = !menuExpanded)"
                      Style="margin-left: -18px; margin-right: 10px;">
            <FluentIcon Value="@(new Icons.Regular.Size20.LineHorizontal3())" Color="Color.Fill" />
        </FluentButton>

        Portal do Publicador

        <FluentSpacer />

        <FluentButton BackgroundColor="rgba(0, 0, 0, 0)">
            <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" Color="Color.Fill" />
        </FluentButton>
    </FluentHeader>

    <FluentStack Orientation="Orientation.Horizontal" Style="height: calc(100vh - 50px);">

        <FluentNavMenu Width="250"
                       @bind-Expanded="menuExpanded"
                       Collapsible="false"
                       Title="Portal do Publicador">
            <FluentNavLink Href="" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())">
                Início
            </FluentNavLink>
            <FluentNavLink Href="usuarios" Icon="@(new Icons.Regular.Size20.Calendar())">
                Programações
            </FluentNavLink>
            <FluentNavLink Href="" Icon="@(new Icons.Regular.Size20.PersonAvailable())">
                Designações
            </FluentNavLink>
            <FluentNavLink Href="" Icon="@(new Icons.Regular.Size20.Map())">
                Territórios
            </FluentNavLink>
            <FluentNavLink Href="" Icon="@(new Icons.Regular.Size20.Clock())">
                Relatório
            </FluentNavLink>
            <FluentNavGroup Title="Congregação" Icon="@(new Icons.Regular.Size20.BuildingPeople())">
                <FluentNavLink Href="usuarios" Title="Usuários" Icon="@(new Icons.Regular.Size20.People())">
					Usuários
                </FluentNavLink>
            </FluentNavGroup>
        </FluentNavMenu>

        <FluentBodyContent Style="padding: 25px; overflow-y: auto;">
            @Body
        </FluentBodyContent>

    </FluentStack>

    <FluentToastProvider />
    <FluentMessageBarProvider />
    <FluentDialogProvider />
</FluentLayout>

@code {
    private bool menuExpanded = true;
}