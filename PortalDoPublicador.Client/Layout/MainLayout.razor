@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<FluentLayout>

    <!-- Header -->
    <FluentLayoutItem Area="@LayoutArea.Header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" VerticalGap="4px">
            <FluentLayoutHamburger Visible="true" />

            <FluentText Weight="TextWeight.Bold"
                        Size="TextSize.Size400">
                <a href="/" style="all: unset; cursor: pointer;">Portal do Publicador</a>
            </FluentText>

            <FluentSpacer />

            <FluentButton IconOnly="true" Appearance="ButtonAppearance.Transparent">
                <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" />
                <FluentCounterBadge Count="2"
                    Color="BadgeColor.Danger"
                    Positioning="Positioning.BelowEnd"
                    Size="BadgeSize.Small"
                    OffsetX="-5"
                    OffsetY="-5" />
            </FluentButton>
            
            <AuthorizeView>
                <Authorized>
                    <FluentButton Appearance="ButtonAppearance.Transparent" OnClick="Sair">Sair</FluentButton>
                </Authorized>
            </AuthorizeView>

        </FluentStack>
    </FluentLayoutItem>

    <!-- Navigation -->
    <FluentLayoutItem Area="@LayoutArea.Navigation"
                      Width="250px">
        <Nav />
    </FluentLayoutItem>

    <!-- Content -->
    <FluentLayoutItem Area="@LayoutArea.Content"
                      Padding="@Padding.All6">
        @Body
    </FluentLayoutItem>

</FluentLayout>

<FluentProviders />

@code {
    private async Task Sair()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        ((PortalDoPublicador.Client.Infrastructure.Auth.SimpleAuthStateProvider)AuthStateProvider).NotifyUserLogout();
        NavigationManager.NavigateTo("/login");
    }
}