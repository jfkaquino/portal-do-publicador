@typeparam TItem
@implements IGridComAcoes
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<CascadingValue Value="this" IsFixed="true">
    <CascadingValue Value="(IGridComAcoes)this" IsFixed="true">
        @Definicoes
    </CascadingValue>
</CascadingValue>

<div style="width: 100%;">
    <!-- Barra Superior: Busca e Botões de Ação -->
    <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom: 16px; gap: 16px; width: 100%;">
        <FluentSearch @bind-Value="_termoBusca" Placeholder="Buscar" Immediate="true" />

        <div style="flex-grow: 1; min-width: 0;">
            <FluentOverflow Orientation="Orientation.Horizontal" Style="justify-content: flex-end;">
                <ChildContent>
                    @{ int order = -1; }
                    @foreach (var acao in AcoesAtivas.Reverse())
                    {
                        <FluentOverflowItem Id="@acao.Id" Style="@($"order: {order--};")">
                            <FluentButton Appearance="@acao.Aparencia" IconStart="@acao.Icone" OnClick="@acao.OnClick" Style="margin-left: 8px;">
                                @acao.Texto
                            </FluentButton>
                        </FluentOverflowItem>
                    }
                </ChildContent>

                <MoreButtonTemplate Context="overflow">
                    <FluentButton Id="@overflow.IdMoreButton" Appearance="Appearance.Stealth" IconEnd="@(new Icons.Regular.Size16.MoreVertical())" OnClick="@(() => _overflowOpen = !_overflowOpen)" />
                </MoreButtonTemplate>

                <OverflowTemplate Context="overflow">
                    <FluentMenu Anchor="@overflow.IdMoreButton" @bind-Open="_overflowOpen">
                        @foreach (var itemOverflow in overflow.ItemsOverflow)
                        {
                            if (AcoesAtivas.FirstOrDefault(a => a.Id == itemOverflow.Id) is { } acao)
                            {
                                <FluentMenuItem OnClick="@(() => { _overflowOpen = false; acao.OnClick.InvokeAsync(); })">
                                    @if (acao.Icone != null)
                                    {
                                        <FluentIcon Value="@acao.Icone" Color="Color.Neutral" Slot="start" />
                                    }
                                    @acao.Texto
                                </FluentMenuItem>
                            }
                        }
                    </FluentMenu>
                </OverflowTemplate>
            </FluentOverflow>
        </div>
    </FluentStack>

    <!-- Grade de Dados (Desktop) -->
    <div class="tabela-desktop">
        <FluentDataGrid Items="@ItensFiltrados" TGridItem="TItem" ResizableColumns="true"
                        GridTemplateColumns="@GridTemplateColumns" Style="width: 100%;"
                        OnRowClick="@(args => HandleItemClick(args.Item))" RowStyle="@ObterEstiloLinha" MultiLine="true">
            <ChildContent>
                @foreach (var col in ColunasAtivas)
                {
                    <TemplateColumn Title="@col.Titulo" Sortable="@(col.SortBy != null)" SortBy="@col.SortBy">
                        @RenderCell(col, context)
                    </TemplateColumn>
                }
                @ChildContent
            </ChildContent>

            <LoadingContent>
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 24px;">
                    <FluentProgressRing />
                    <FluentLabel>Carregando...</FluentLabel>
                </FluentStack>
            </LoadingContent>

            <EmptyContent>
                @ConteudoVazioTemplate
            </EmptyContent>
        </FluentDataGrid>
    </div>

    <!-- Cards (Mobile) -->
    <div class="tabela-mobile">
        @if (!ItensFiltrados.Any())
        {
            @ConteudoVazioTemplate
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" Style="width: 100%; gap: 12px;">
                @foreach (var item in ItensFiltrados)
                {
                    <FluentCard Class="mobile-card" Style="@($"{ObterEstiloLinha(item)}")" @onclick="@(() => HandleItemClick(item))">
                        <FluentStack Orientation="Orientation.Vertical" Style="gap: 4px; width: 100%;">
                            @foreach (var col in ColunasAtivas)
                            {
                                <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="width: 100%; gap: 8px; align-items: center;" Wrap="true">
                                    <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@col.Titulo</FluentLabel>
                                    <div>
                                        @RenderCell(col, item)
                                    </div>
                                </FluentStack>
                            }
                        </FluentStack>
                    </FluentCard>
                }
            </FluentStack>
        }
    </div>
</div>

<style>
    /* Apenas o que NÃO pode ser inline (Responsividade e Hover) */
    .tabela-mobile {
        display: none;
    }

    @@media (max-width: 768px) {
        .tabela-desktop {
            display: none;
        }

        .tabela-mobile {
            display: block;
        }
    }
</style>

@code {
    private string _termoBusca = string.Empty;
    private bool _overflowOpen = false;
    private readonly List<ColunaGrid<TItem>> _colunasMarkup = [];
    private readonly List<AcaoGrid> _acoesMarkup = [];

    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public IEnumerable<ColunaGrid<TItem>> Colunas { get; set; } = [];
    [Parameter] public IEnumerable<AcaoGrid> Acoes { get; set; } = [];
    [Parameter] public RenderFragment? Definicoes { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? GridTemplateColumns { get; set; }
    [Parameter] public EventCallback<TItem> OnItemClick { get; set; }

    public IEnumerable<ColunaGrid<TItem>> ColunasAtivas => Colunas.Concat(_colunasMarkup);
    public IEnumerable<AcaoGrid> AcoesAtivas => Acoes.Concat(_acoesMarkup);

    private IQueryable<TItem> ItensFiltrados
    {
        get
        {
            var query = Items ?? [];
            if (!string.IsNullOrWhiteSpace(_termoBusca))
                query = query.Where(item => ContemTermoBusca(item, _termoBusca));

            return query.AsQueryable();
        }
    }

    private RenderFragment RenderCell(ColunaGrid<TItem> col, TItem item)
    {
        if (col.Template is not null) return col.Template(item);
        if (col.Valor is not null) return @<text>@col.Valor(item)</text>;
        return @<text></text>;
    }

    private RenderFragment ConteudoVazioTemplate =>
        @<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 24px;">
            <FluentIcon Value="@(new Icons.Regular.Size24.CollectionsEmpty())" Color="Color.Neutral" />
            <FluentLabel>Sem resultados.</FluentLabel>
        </FluentStack>;

    internal void AddColuna(ColunaGrid<TItem> coluna)
    {
        if (!_colunasMarkup.Any(c => c.Titulo == coluna.Titulo))
        {
            _colunasMarkup.Add(coluna);
            StateHasChanged();
        }
    }

    public void AddAcao(AcaoGrid acao)
    {
        if (!_acoesMarkup.Any(a => a.Texto == acao.Texto))
        {
            _acoesMarkup.Add(acao);
            StateHasChanged();
        }
    }

    private Task HandleItemClick(TItem? item) =>
        item is not null && OnItemClick.HasDelegate ? OnItemClick.InvokeAsync(item) : Task.CompletedTask;

    private string ObterEstiloLinha(TItem item) =>
        OnItemClick.HasDelegate ? "cursor: pointer;" : string.Empty;

    private bool ContemTermoBusca(TItem item, string termo)
    {
        if (item is null) return false;

        return item.ToString()?.Contains(termo, StringComparison.OrdinalIgnoreCase) == true ||
               ColunasAtivas.Any(col => col.Valor?.Invoke(item)?.Contains(termo, StringComparison.OrdinalIgnoreCase) == true);
    }
}