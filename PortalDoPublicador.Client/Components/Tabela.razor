@typeparam TItem
@using System.Reflection
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<FluentStack Orientation="Orientation.Vertical" Width="100%" Style="gap: 16px;">
    <!-- Barra Superior: Busca e Botões de Ação -->
    <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Wrap="true" Width="100%">
        <FluentSearch @bind-Value="_termoBusca" Placeholder="Buscar" Immediate="true" Width="300px" />

        @if (BotoesAcao is not null)
        {
            <FluentStack HorizontalAlignment="HorizontalAlignment.End" Width="auto" Style="gap: 8px;">
                @BotoesAcao
            </FluentStack>
        }
    </FluentStack>

    <!-- Grade de Dados -->
    <FluentDataGrid Items="@ItensFiltrados" TGridItem="TItem" ResizableColumns="true"
                    GridTemplateColumns="@GridTemplateColumns"
                    Style="width: 100%;"
                    OnRowClick="HandleRowClick"
                    RowStyle="ObterEstiloLinha">

        <ChildContent>
            @ChildContent
        </ChildContent>

        <EmptyContent>
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 24px;">
                <FluentIcon Value="@(new Icons.Regular.Size24.CollectionsEmpty())" Color="Color.Neutral" />
                <FluentLabel>Sem resultados.</FluentLabel>
            </FluentStack>
        </EmptyContent>
    </FluentDataGrid>
</FluentStack>

@code {
    private string _termoBusca = string.Empty;
    private PropertyInfo[]? _props;

    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? BotoesAcao { get; set; }
    [Parameter] public string? GridTemplateColumns { get; set; }
    [Parameter] public EventCallback<TItem> OnItemClick { get; set; }

    private IQueryable<TItem> ItensFiltrados
    {
        get
        {
            var query = (Items ?? Array.Empty<TItem>()).AsQueryable();

            if (string.IsNullOrWhiteSpace(_termoBusca))
                return query;

            return query.Where(item => ContemTermoBusca(item, _termoBusca));
        }
    }

    // Manipulador do clique na linha do DataGrid
    private async Task HandleRowClick(FluentDataGridRow<TItem> args)
    {
        if (OnItemClick.HasDelegate && args.Item is not null)
        {
            await OnItemClick.InvokeAsync(args.Item);
        }
    }

    // Só muda o cursor para pointer (clicável) se houver um evento OnItemClick atrelado
    private string ObterEstiloLinha(TItem item) => OnItemClick.HasDelegate ? "cursor: pointer;" : string.Empty;

    private bool ContemTermoBusca(TItem item, string termo)
    {
        if (item is null) return false;

        if (item.ToString()?.Contains(termo, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        _props ??= typeof(TItem).GetProperties(BindingFlags.Public | BindingFlags.Instance)
                                .Where(p => p.CanRead && p.GetIndexParameters().Length == 0)
                                .ToArray();

        return _props.Any(p =>
        {
            try
            {
                return p.GetValue(item)?.ToString()?.Contains(termo, StringComparison.OrdinalIgnoreCase) == true;
            }
            catch
            {
                return false;
            }
        });
    }
}